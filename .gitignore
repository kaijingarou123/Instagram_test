__pycache__/
*.pyc
.env
assets/contact-sheet.jpg
output/reels/*-frames.jpg
output/reels/*-check.jpg

# format library: large binaries stay local (specs, posters, preview page are committed)
output/formats/*.mp4
output/formats/_*
assets/video/**/*.webm

# photos fetched for the format library (local only; credits.json kept)
assets/raw/*/*.jpg
!assets/raw/axolotl/*.jpg
!assets/raw/barn-owl/*.jpg
!assets/raw/honey-bee/*.jpg
!assets/raw/hummingbird/*.jpg
!assets/raw/mantis-shrimp/*.jpg
!assets/raw/octopus/*.jpg
!assets/raw/orca/*.jpg
!assets/raw/pangolin/*.jpg
!assets/raw/snow-leopard/*.jpg

# insight dashboard: generated documents and run files (log/agent/ and thumbs.json are the source of truth)
log/dashboard/out/
log/dashboard/thumbs/
log/dashboard/changed.json
log/dashboard/readings.json

# Reels music library: recordings stay local (re-fetch with scripts/fetch_commons_music.py); the index is committed
assets/music/*
!assets/music/library.json

# Owner inspiration files (large videos), read by the agent, never committed
inputs/

# Archived renders, safe to delete in one go
archive/

# Studio previews live in the artifact, not on Pages
output/studio/
